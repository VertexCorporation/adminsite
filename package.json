{
  "name": "vertex-admin",
  "private": true,
  "scripts": {
    "test:browser": "node tests/browser.cjs",
    "test": "node scripts/test.cjs",
    "audit:i18n": "node tests/i18n-audit.cjs",
    "test:startup": "node tests/startup-i18n.cjs",
    "verify:release": "node scripts/verify-release.cjs",
    "check:syntax": "node scripts/check-syntax.cjs",
    "check:architecture": "node scripts/check-architecture.cjs",
    "build": "node scripts/release.cjs",
    "format": "prettier --write js l10n partials css scripts index.html customer-activate.html",
    "format:check": "prettier --check js l10n partials css scripts index.html customer-activate.html",
    "check:localization": "node scripts/check-localization.cjs"
  },
  "devDependencies": {
    "esbuild": "0.27.0",
    "jsdom": "27.0.1",
    "markdown-it": "15.0.0",
    "playwright": "1.62.1",
    "prettier": "3.9.10"
  }
}
