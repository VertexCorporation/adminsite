+// Existing users.isVertex and Firebase Auth identity remain authoritative.
+async function resolveMembership({auth,db,email}) {
+  if(typeof email!=='string'||!email.includes('@'))return {status:'unknown'};
+  try {
+    const account=await auth.getUserByEmail(email.trim());
+    if(account.disabled||!account.emailVerified||account.email?.toLowerCase()!==email.trim().toLowerCase())return {status:'unknown'};
+    const doc=await db.collection('users').doc(account.uid).get();
+    const data=doc.data();
+    if(!doc.exists||typeof data?.isVertex!=='boolean'||(data.email&&data.email.toLowerCase()!==account.email.toLowerCase()))return {status:'unknown'};
+    return {status:'matched',uid:account.uid,isVertex:data.isVertex};
+  } catch(error) {
+    if(error.code==='auth/user-not-found')return {status:'unknown'};
+    throw error;
+  }
+}
+async function revokeAdministrator({auth,db,actorUid,email,HttpsError}) {
+  const target=await auth.getUserByEmail(email);
+  if(target.uid===actorUid)throw new HttpsError('failed-precondition','Self-revocation is not allowed.');
+  const actor=await auth.getUser(actorUid);
+  if(actor.customClaims?.admin!==true)throw new HttpsError('permission-denied','Administrator access is required.');
+  if(target.customClaims?.admin!==true)throw new HttpsError('failed-precondition','Target is not an active administrator.');
+  const collection=db.collection('admins'),targetRef=collection.doc(target.uid);
+  const saved=await db.runTransaction(async tx=>{
+    const roster=await tx.get(collection);
+    // Deleting this existing roster document serializes concurrent revocations.
+    // The actor must still be on the roster; the last administrator cannot be removed.
+    if(roster.size<2||!roster.docs.some(d=>d.id===actorUid)||!roster.docs.some(d=>d.id===target.uid))throw new HttpsError('failed-precondition','Administrator roster changed. Refresh and try again.');
+    const record=roster.docs.find(d=>d.id===target.uid).data();
+    if(record.email?.toLowerCase()!==target.email?.toLowerCase())throw new HttpsError('failed-precondition','Administrator identity does not match.');
+    tx.delete(targetRef);return record;
+  });
+  try {const latest=await auth.getUser(target.uid);await auth.setCustomUserClaims(target.uid,{...latest.customClaims,admin:false});}
+  catch(error){
+    // Restore only the roster entry if Auth rejects the revocation; never grant claims here.
+    await db.runTransaction(async tx=>{const current=await tx.get(targetRef);if(!current.exists)tx.set(targetRef,saved);});
+    throw error;
+  }
+  return target;
+}
+module.exports={resolveMembership,revokeAdministrator};
+
+async function resolveMemberships({auth,db,emails}) {
+  const result=new Map();
+  const unique=[...new Set(emails.filter(email=>typeof email==='string'&&/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim())).map(email=>email.trim().toLowerCase()))];
+  for(let i=0;i<unique.length;i+=100){
+    const batch=unique.slice(i,i+100);
+    const {users}=await auth.getUsers(batch.map(email=>({email})));
+    const verified=users.filter(account=>!account.disabled&&account.emailVerified&&batch.includes(account.email?.toLowerCase()));
+    if(!verified.length)continue;
+    const docs=await db.getAll(...verified.map(account=>db.collection('users').doc(account.uid)));
+    verified.forEach((account,index)=>{
+      const doc=docs[index],data=doc.data();
+      if(doc.exists&&typeof data?.isVertex==='boolean'&&(!data.email||data.email.toLowerCase()===account.email.toLowerCase()))result.set(account.email.toLowerCase(),{status:'matched',uid:account.uid,isVertex:data.isVertex});
+    });
+  }
+  return result;
+}
+module.exports.resolveMemberships=resolveMemberships;
